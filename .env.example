# Copy this file to .env.local and fill in real values from the Supabase
# dashboard (Project Settings -> API). Never commit .env.local — it's gitignored.
#
# This project shares the portfolio's one Supabase project (master_db) —
# don't create a new Supabase project for it. Get the real values either
# from the dashboard, or run:
#   node C:\Users\Taufik\project\scripts\setup-supabase-env.mjs sbmp
# to push Production env vars straight to this project's Vercel deployment
# (reads working values out of duitduit/.env.local). See README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000

# For `npm run test:e2e` (Playwright smoke tests) — a dedicated test
# account's login, not your own. Authenticated tests skip themselves if
# these aren't set. Also needed as GitHub Actions secrets of the same
# names for CI.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Base URL for Playwright e2e tests (playwright.config.ts). Point at a real
# deployment to skip spinning up a local dev server for the test run;
# defaults to http://localhost:3000 if unset.
E2E_BASE_URL=
